#!/bin/bash
#SBATCH --partition=gpu_h100
#SBATCH --gpus=2
#SBATCH --job-name=SFT_eval_gaia_qwen8B_sub1_7b_none
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --time=24:00:00
#SBATCH --output=out/experiments/SFT/eval_gaia_qwen8B_sub1_7b_none/SFT_eval_gaia_qwen8B_sub1_7b_none_%A.log

# SFT inference eval on GAIA — mirrors GRPO_eval_gaia_qwen8B_sub1_7b_none.job but
# uses the SFT LoRA adapter.
# Merges FSDP shards into a PEFT adapter if not already done, then runs eval.
#
# TODO: set CKPT_DIR below and the matching lora_adapter_path in
#   configs/gaia/qwen8B_sft_sub1_7b_none.yaml to the SAME SFT checkpoint before submitting. 

module purge
module load 2025
module load Miniconda3/25.5.1-1
module load CUDA/12.8.0

echo "Job ID: $SLURM_JOB_ID"
echo "Node: $SLURM_NODELIST"
echo "GPUs: $SLURM_GPUS"
echo "Start time: $(date)"

PROJECT_DIR="/gpfs/work5/0/gusr0608/msc-thesis"
cd "$PROJECT_DIR" || exit 1

CKPT_DIR="<TODO: path to SFT checkpoint, e.g. /scratch-shared/xchen/fine_tuning/sft/qwen3-8b-sft-v1/global_step_90>"
ADAPTER_PATH="$CKPT_DIR/merged_best/lora_adapter"

# Redirect Triton/wandb caches off /home (quota ~10 GB) to scratch-shared —
# vLLM compiles GPU kernels on first use and crashes if it can't write this cache.
export TRITON_CACHE_DIR="/scratch-shared/${USER}/triton_cache"
export WANDB_CACHE_DIR="/scratch-shared/${USER}/wandb_cache"
mkdir -p "$TRITON_CACHE_DIR" "$WANDB_CACHE_DIR"

# Merge FSDP shards into a usable PEFT adapter if not already done.
# VERL's SFT trainer saves raw shards; GRPO saves the adapter directly — this
# one-time merge step makes them equivalent for inference.
# Runs in a subshell so the cosmas-train conda activation doesn't leak into
# the parent shell (chaining two `source activate` calls breaks the second one).
if [[ ! -d "$ADAPTER_PATH" ]]; then
    echo "Merging FSDP shards into LoRA adapter at $ADAPTER_PATH ..."
    (
        source activate cosmas-train
        # verl's model_merger assumes peft_config["task_type"]/["peft_type"] are
        # enums with a .value attribute, but VERL's SFT trainer saves task_type
        # as a plain string ("CAUSAL_LM") in lora_train_meta.json. Patch the
        # installed package once to accept both.
        MERGER_FILE="$(python -c 'import verl.model_merger.base_model_merger as m; print(m.__file__)')"
        if ! grep -q 'getattr(peft_config\["task_type"\]' "$MERGER_FILE"; then
            sed -i \
                -e 's/peft_config\["task_type"\] = peft_config\["task_type"\]\.value if peft_config\["task_type"\] else None/peft_config["task_type"] = getattr(peft_config["task_type"], "value", peft_config["task_type"]) if peft_config["task_type"] else None/' \
                -e 's/peft_config\["peft_type"\] = peft_config\["peft_type"\]\.value if peft_config\["peft_type"\] else None/peft_config["peft_type"] = getattr(peft_config["peft_type"], "value", peft_config["peft_type"]) if peft_config["peft_type"] else None/' \
                "$MERGER_FILE"
        fi
        python -m verl.model_merger merge \
            --backend fsdp \
            --local_dir "$CKPT_DIR" \
            --target_dir "$CKPT_DIR/merged_best"
    )
    if [[ $? -ne 0 ]]; then
        echo "ERROR: model_merger failed."
        exit 1
    fi
    echo "Merge complete."
else
    echo "Merged adapter already exists, skipping merge."
fi

source activate agent_engine

if [ -f ".env" ]; then
    set -a
    source .env
    set +a
fi

export PYTHONHASHSEED=0
export PYTHONNOUSERSITE=1
export TOKENIZERS_PARALLELISM=false

python -c "import numpy, torch" 2>/dev/null || {
    echo "ERROR: numpy/torch not in conda env. Re-run the setup job (001_setup.job)."
    exit 1
}

mkdir -p out/experiments/SFT/eval_gaia_qwen8B_sub1_7b_none

echo "Running experiment: SFT_eval_gaia_qwen8B_sub1_7b_none"
python scripts/run_experiment.py \
    --config "$PROJECT_DIR/jobs/grpo_inference/configs/gaia/qwen8B_sft_sub1_7b_none.yaml" \
    --output-dir experiments/results/sft_inference/gaia/qwen8B_sft_sub1_7b_none

EXIT_CODE=$?

echo "Exit code: $EXIT_CODE"
echo "End time: $(date)"

exit $EXIT_CODE
