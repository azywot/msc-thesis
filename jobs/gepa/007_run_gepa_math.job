#!/bin/bash
#SBATCH --job-name=GEPAMath
#SBATCH --partition=gpu_h100
# Three H100 NVL GPUs (~94 GB each).
#   GPU 0:    agent vLLM (Qwen3-8B, tp=1, ~16 GB weights + KV cache)
#   GPUs 1–2: reflector vLLM (Qwen3-32B, tp=2, ~64 GB weights + KV cache)
#SBATCH --gpus=3
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --time=24:00:00
#SBATCH --output=out/gepa/gepa_math_%A.log
#SBATCH --error=out/gepa/gepa_math_%A.err

# GEPA prompt optimisation — MATH benchmark only.
#
# What this job does:
#   1. Start Qwen3-32B reflector vLLM on GPUs 1–2 (port 8001).
#   2. Run GEPA optimisation (~9h): evolves system_prompt + planning_suffix.
#   3. Evaluate best candidate on held-out test.
#   4. Print prompt diff (seed → best).
#   5. Kill reflector and exit.
#
# Prerequisites:
#   - Job 001 completed (agent_engine conda env exists)
#   - GEPA data prepared: data/gepa/math/all_examples.json
#     Run: python src/gepa_integration/data/prepare.py --preset math \
#              --output-dir data/gepa/math \
#              --splits-out experiments/configs/gepa/splits/math_gepa_splits.json \
#              --seed 1
#   - SERPER_API_KEY set in .env

set -euo pipefail

echo "=========================================="
echo "MSC Thesis — GEPA Prompt Optimisation (MATH)"
echo "=========================================="
echo "Start time: $(date)"
echo "Job ID: ${SLURM_JOB_ID:-local}  Node: $(hostname)"
echo ""

module purge
module load 2025
module load Miniconda3/25.5.1-1

PROJECT_DIR="${PROJECT_DIR:-$HOME/azywot/msc-thesis}"
cd "$PROJECT_DIR" || exit 1
echo "Project directory: $PROJECT_DIR"

if [[ -f ".env" ]]; then
    echo "Loading environment variables from .env..."
    set -a
    source <(grep -v '^#' .env | grep -v '^$' | grep -v '^[[:space:]]*#')
    set +a
fi

if [[ -z "${SERPER_API_KEY:-}" && -z "${TAVILY_API_KEY:-}" ]]; then
    echo "ERROR: SERPER_API_KEY or TAVILY_API_KEY must be set for web search during agent rollouts."
    exit 1
fi

ENV_NAME="${ENV_NAME:-agent_engine}"
echo "Activating environment: $ENV_NAME"
source activate "$ENV_NAME"
export PYTHONNOUSERSITE=1

export VLLM_LOGGING_LEVEL=WARNING
export TOKENIZERS_PARALLELISM=false

python -c "from gepa.api import optimize; from gepa_integration.adapter import AgentGEPAAdapter; print('GEPA imports OK')"

mkdir -p out/gepa

# ── Cleanup trap ─────────────────────────────────────────────────────────────

REFLECTOR_PID=""
cleanup() {
    if [[ -n "${REFLECTOR_PID:-}" ]] && kill -0 "$REFLECTOR_PID" >/dev/null 2>&1; then
        echo "Stopping reflector vLLM (pid=$REFLECTOR_PID)..."
        kill -TERM "$REFLECTOR_PID" 2>/dev/null || true
        # Wait up to 30 s for graceful shutdown, then SIGKILL.
        # vLLM spawns Ray workers that may not exit on SIGTERM alone;
        # without this, 'wait' blocks indefinitely and the job hangs.
        for _i in $(seq 1 30); do
            sleep 1
            kill -0 "$REFLECTOR_PID" >/dev/null 2>&1 || break
        done
        if kill -0 "$REFLECTOR_PID" >/dev/null 2>&1; then
            echo "Reflector still alive after 30 s — sending SIGKILL..."
            kill -KILL "$REFLECTOR_PID" 2>/dev/null || true
        fi
        wait "$REFLECTOR_PID" 2>/dev/null || true
    fi
}
trap cleanup EXIT

# ── 1. Start reflector vLLM (Qwen3-32B on GPUs 1–2, port 8001) ──────────────

echo ""
echo "Starting Qwen3-32B reflector vLLM on GPUs 1–2, port 8001..."
REFLECTOR_LOG="out/gepa/gepa_math_${SLURM_JOB_ID:-local}_reflector.log"
CUDA_VISIBLE_DEVICES=1,2 vllm serve Qwen/Qwen3-32B \
    --port 8001 \
    --tensor-parallel-size 2 \
    --dtype bfloat16 \
    --gpu-memory-utilization 0.85 \
    --enable-prefix-caching \
    --max-model-len 40960 \
    > "$REFLECTOR_LOG" 2>&1 &
REFLECTOR_PID=$!

echo "Waiting 90s for reflector vLLM to start..."
sleep 90
if ! kill -0 "$REFLECTOR_PID" >/dev/null 2>&1; then
    echo "FAIL — reflector vLLM exited during startup. See $REFLECTOR_LOG"
    exit 1
fi

echo "Polling http://localhost:8001/health for reflector readiness..."
_deadline=$((SECONDS + 600))
while (( SECONDS < _deadline )); do
    if curl -fsS --max-time 5 "http://127.0.0.1:8001/health" >/dev/null 2>&1; then
        echo "Reflector vLLM is ready."
        break
    fi
    if ! kill -0 "$REFLECTOR_PID" >/dev/null 2>&1; then
        echo "FAIL — reflector vLLM exited before becoming ready. See $REFLECTOR_LOG"
        exit 1
    fi
    sleep 10
done
if (( SECONDS >= _deadline )); then
    echo "FAIL — reflector not ready after 10 min. Check $REFLECTOR_LOG"
    exit 1
fi

export CUDA_VISIBLE_DEVICES=0

TIMESTAMP="$(date +%Y-%m-%d-%H-%M-%S)"
JOB_ID="${SLURM_JOB_ID:-local}"

# ── 2. MATH ──────────────────────────────────────────────────────────────────

BENCHMARK="math"
CONFIG="experiments/configs/gepa/${BENCHMARK}.yaml"
RUN_DIR="experiments/results/gepa/${BENCHMARK}/${TIMESTAMP}_${JOB_ID}"
mkdir -p "$RUN_DIR"

echo ""
echo "══════════════════════════════════════════"
echo "  Benchmark: MATH"
echo "  Run dir:  $RUN_DIR"
echo "══════════════════════════════════════════"

splits_file=$(python -c "import yaml; c=yaml.safe_load(open('$CONFIG')); print(c['splits_file'])")
if [[ ! -f "$splits_file" ]]; then
    echo "ERROR: splits file not found: $splits_file"
    echo "Generate it with: python src/gepa_integration/data/prepare.py --preset math ..."
    exit 1
fi

echo ""
echo "Starting GEPA optimisation for MATH..."
_ERR="$RUN_DIR/optimize.stderr"
python scripts/run_gepa.py --mode optimize --config "$CONFIG" --run-dir "$RUN_DIR" 2>"$_ERR" \
    || { echo "ERROR: optimize failed. Stderr:"; cat "$_ERR" >&2; exit 1; }

echo ""
echo "Evaluating best candidate on held-out test set..."
_ERR="$RUN_DIR/evaluate.stderr"
python scripts/run_gepa.py --mode evaluate --config "$CONFIG" --run-dir "$RUN_DIR" 2>"$_ERR" \
    || { echo "ERROR: evaluate failed. Stderr:"; cat "$_ERR" >&2; exit 1; }

echo ""
echo "Prompt diff (seed → best):"
python scripts/run_gepa.py --mode diff --config "$CONFIG" --run-dir "$RUN_DIR"

# ── Done ─────────────────────────────────────────────────────────────────────

echo ""
echo "=========================================="
echo "MATH GEPA complete."
result_file="$RUN_DIR/gepa_results.json"
if [[ -f "$result_file" ]]; then
    n_correct=$(python -c "import json; r=json.load(open('$result_file')); print(sum(x['correct'] for x in r))")
    n_total=$(python -c "import json; r=json.load(open('$result_file')); print(len(r))")
    echo "  MATH: ${n_correct}/${n_total}"
fi
echo "  Best candidate: $RUN_DIR/best_candidate.json"
echo ""
echo "End time: $(date)"
echo "=========================================="
