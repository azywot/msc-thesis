#!/bin/bash
#SBATCH --job-name=PrefixRFTTests
# CPU partition on purpose: nothing here needs a GPU (no model is loaded, only the
# tokenizer), so running it on gpu_h100 would burn GPU SBUs to do string comparisons.
#SBATCH --partition=genoa
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --time=01:00:00
#SBATCH --output=out/fine_tuning/tests/prefix_rft_tests_%A.log
#SBATCH --error=out/fine_tuning/tests/prefix_rft_tests_%A.err

# Verification suite for the Prefix-RFT pipeline. Run after 008_build_prefix_demos.job
# and before 010_smoke_prefix_rft.job, and after any change to the store builder, the
# replay shims, or the copied methods.
#
# Why this job exists
# -------------------
# Three of the failures this pipeline can have are silent. A demonstration attached to
# the wrong question, a prefix_mask misaligned with the responses it marks, or a copied
# verl method left stale by an upgrade all produce a run that trains, logs, checkpoints
# and reports success while optimising the wrong thing. Everything below is minutes of
# CPU; the failures it guards against cost a multi-hour GPU run plus the time to work
# out afterwards that the numbers meant nothing.
#
# Four stages, each independently fatal:
#   1. Unit tests under agent_engine  — the logic, in the env that has pytest.
#   2. Gate on the real store         — every demonstration is replayable, and
#                                       replayed turns tokenise as the proxy does.
#   3. Trip-wire                      — the gate must REJECT a corrupted store. A gate
#                                       that passes everything proves nothing.
#   4. cosmas-train checks            — the copied methods still match their sources, and
#                                       every module imports in the env VERL actually
#                                       uses. pytest is not installed there, so these run
#                                       as scripts.
#
# No GPU, no network, no model weights.

set -uo pipefail   # NOT -e: stages must all run so the summary is complete.

echo "=========================================="
echo "MSc Thesis — Prefix-RFT verification suite"
echo "=========================================="
echo "Start time: $(date)"
echo "Job ID: ${SLURM_JOB_ID:-local}  Node: $(hostname)"
echo ""

module purge
module load 2025
module load Miniconda3/25.5.1-1

# Locate the checkout. Under sbatch, SLURM copies this script to /var/spool/slurm on the
# compute node, so BASH_SOURCE points at the spool copy, not the repo. Try each candidate
# and accept only one that actually looks like the repo.
_is_repo() { [[ -n "${1:-}" && -f "$1/scripts/build_prefix_demos.py" ]]; }
_JOB_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd)"
for _cand in "${PROJECT_DIR:-}" \
             "${SLURM_SUBMIT_DIR:-}" \
             "$(cd "${_JOB_DIR}/../.." 2>/dev/null && pwd)" \
             "$HOME/azywot/msc-thesis"; do
    if _is_repo "$_cand"; then PROJECT_DIR="$_cand"; break; fi
done
if ! _is_repo "${PROJECT_DIR:-}"; then
    echo "ERROR: could not locate the msc-thesis checkout."
    echo "  Tried: \$PROJECT_DIR, \$SLURM_SUBMIT_DIR (${SLURM_SUBMIT_DIR:-unset}),"
    echo "         script dir (${_JOB_DIR:-unset}), \$HOME/azywot/msc-thesis"
    echo "  Fix: sbatch --export=ALL,PROJECT_DIR=/path/to/msc-thesis $0"
    exit 1
fi
cd "$PROJECT_DIR" || exit 1
echo "Project directory: $PROJECT_DIR"
export PYTHONUNBUFFERED=1
export PYTHONNOUSERSITE=1


mkdir -p out/fine_tuning/tests

DEMOS=data/training/prefix_rft/prefix_demos.parquet

FAILURES=()
note_fail() { FAILURES+=("$1"); echo "  ✗ FAIL: $1"; }
note_pass() { echo "  ✓ PASS: $1"; }

if [[ ! -f "$DEMOS" ]]; then
    echo "ERROR: missing $DEMOS"
    echo "Build it first: sbatch jobs/fine_tuning/008_build_prefix_demos.job"
    exit 1
fi

# ── Stage 1/4: unit tests under agent_engine ─────────────────────────────────────
# verl is not installed here, so the verl-dependent cases skip themselves; stage 4
# covers them. This is why the logic lives in verl-free modules.
echo ""
echo "── Stage 1/4: Prefix-RFT unit tests (env: agent_engine) ─────────────────────"
source activate agent_engine
python -m pytest tests/unit/test_prefix_rft_schedule.py \
                 tests/unit/test_prefix_rft_demos.py \
                 tests/unit/test_prefix_rft_rollout.py \
                 tests/unit/test_prefix_rft_daemon.py \
                 tests/unit/test_prefix_rft_advantage.py \
                 tests/unit/test_prefix_rft_actor.py -v --no-header
if [[ $? -eq 0 ]]; then note_pass "unit tests (agent_engine)"; else note_fail "unit tests (agent_engine)"; fi

echo ""
echo "── Stage 1b/4: the existing GRPO rollout suite must be unaffected ───────────"
# Prefix-RFT added two seams to OrchestratorRollout. They return their argument
# unchanged, and this is what says so.
#
# This module needs BOTH pytest (agent_engine only) AND agentops (cosmas-train
# only), so it can never actually collect under either env — tests/conftest.py's
# pytest_ignore_collect skips it during normal directory discovery, but that hook
# does not fire for a file named explicitly on the command line the way 007 learned
# the hard way. Naming it directly here would re-trigger the exact ModuleNotFoundError
# conftest.py exists to prevent, and always fail this stage for a module that was
# never broken. Guard with the same check conftest.py uses instead of trusting pytest
# to skip an explicit path.
if python -c "import importlib.util,sys; sys.exit(0 if importlib.util.find_spec('agentops') else 1)" 2>/dev/null; then
    python -m pytest tests/unit/test_fine_tuning_rollout.py -q --no-header
    if [[ $? -eq 0 ]]; then note_pass "existing GRPO rollout suite"; else note_fail "existing GRPO rollout suite"; fi
else
    echo "  (skipped: agentops is not installed here, same guard tests/conftest.py uses)"
    note_pass "existing GRPO rollout suite (skipped — agentops unavailable in this env)"
fi

# ── Stage 2/4: the gate, on the real store ───────────────────────────────────────
echo ""
echo "── Stage 2/4: pre-flight gate on the demonstration store ────────────────────"
python scripts/check_prefix_demos.py --demos "$DEMOS"
if [[ $? -eq 0 ]]; then note_pass "gate on the demonstration store"; else note_fail "gate on the demonstration store"; fi

# ── Stage 2b/4: replay tokenisation ──────────────────────────────────────────────
# Replayed turns never reach vLLM, so their token IDs are produced locally. If they
# differ from what the daemon's proxy produces, every prefix triplet is misaligned and
# training reports success while optimising the wrong tokens.
echo ""
echo "── Stage 2b/4: replay tokenisation matches the proxy's ──────────────────────"
python scripts/check_prefix_replay_tokenisation.py --demos "$DEMOS"
if [[ $? -eq 0 ]]; then note_pass "replay tokenisation"; else note_fail "replay tokenisation"; fi

# ── Stage 3/4: trip-wire ─────────────────────────────────────────────────────────
echo ""
echo "── Stage 3/4: trip-wire — the gate must REJECT a corrupted store ────────────"
CORRUPT="${TMPDIR:-/tmp}/prefix_demos_corrupt.parquet"
python - "$DEMOS" "$CORRUPT" <<'PYCORRUPT'
import sys
import pandas as pd

frame = pd.read_parquet(sys.argv[1]).head(50).copy()
target = next(
    (i for i in range(len(frame)) if any(s["tool_name"] for s in frame.iloc[i]["steps"])),
    None,
)
if target is None:
    sys.exit("no multi-step demonstration in the first 50 rows to corrupt")
steps = [dict(s) for s in frame.iloc[target]["steps"]]
for s in steps:
    if s["tool_name"]:
        s["tool_result"] = None      # a tool step replay cannot serve
        break
frame.at[frame.index[target], "steps"] = steps
frame.to_parquet(sys.argv[2], index=False)
print(f"  corrupted row {target}: dropped a stored tool_result")
PYCORRUPT
if python scripts/check_prefix_demos.py --demos "$CORRUPT" > /dev/null 2>&1; then
    note_fail "trip-wire — gate ACCEPTED a store with a missing tool_result"
else
    note_pass "trip-wire — gate rejected the corrupted store"
fi
rm -f "$CORRUPT"

# ── Stage 4/4: the training environment ──────────────────────────────────────────
# verl lives in cosmas-train; pytest does not. These are the same assertions the
# skipped pytest cases make, run as scripts.
echo ""
echo "── Stage 4/4: copied methods and imports (env: cosmas-train) ────────────────"
conda deactivate 2>/dev/null || true
source activate cosmas-train

python scripts/check_prefix_rft_trainer_sync.py
if [[ $? -eq 0 ]]; then note_pass "copied methods and config in sync"; else note_fail "copied methods and config in sync"; fi

python -c "
import sys
sys.path.insert(0, 'src')
from verl_ext.prefix_rft.daemon import PrefixRFTDaemon
from verl_ext.prefix_rft.actor import PrefixRFTActor
from verl_ext.prefix_rft.worker import PrefixRFTWorker
from verl_ext.prefix_rft.trainer import PrefixRFTTrainer
from verl_ext.prefix_rft import entrypoint
from fine_tuning.prefix_rollout import PrefixOrchestratorRollout
from verl.workers.actor.dp_actor import DataParallelPPOActor
from fine_tuning.agentflow.verl.daemon import AgentModeDaemon
from fine_tuning.agentflow.verl.trainer import AgentFlowTrainer
assert issubclass(PrefixRFTActor, DataParallelPPOActor)
assert issubclass(PrefixRFTDaemon, AgentModeDaemon)
assert issubclass(PrefixRFTTrainer, AgentFlowTrainer)
print('  all Prefix-RFT modules import and subclass correctly under cosmas-train')
"
if [[ $? -eq 0 ]]; then note_pass "modules import under cosmas-train"; else note_fail "modules import under cosmas-train"; fi

python -c "
import os, sys
sys.path.insert(0, 'src')
from hydra import compose, initialize_config_dir
import verl_ext.prefix_rft as p
d = os.path.join(os.path.dirname(p.__file__), 'config')
with initialize_config_dir(config_dir=d, version_base=None):
    cfg = compose(config_name='prefix_rft_trainer')
assert cfg.prefix_rft.entropy_keep_ratio == 0.2, cfg.prefix_rft.entropy_keep_ratio
assert cfg.prefix_rft.low_init == 0.95 and cfg.prefix_rft.low_target == 0.05
assert cfg.prefix_rft.n_prefixed_rollouts == 1
assert cfg.actor_rollout_ref.rollout.mode == 'async'
print('  hydra config composes with the paper values')
"
if [[ $? -eq 0 ]]; then note_pass "hydra config composes"; else note_fail "hydra config composes"; fi

# ── Summary ──────────────────────────────────────────────────────────────────────
echo ""
echo "=========================================="
if [[ ${#FAILURES[@]} -eq 0 ]]; then
    echo "ALL STAGES PASSED — safe to submit 010_smoke_prefix_rft.job"
    echo "Finished at: $(date)"
    echo "=========================================="
    exit 0
fi
echo "${#FAILURES[@]} STAGE(S) FAILED — do NOT launch training:"
for f in "${FAILURES[@]}"; do echo "  - $f"; done
echo "Finished at: $(date)"
echo "=========================================="
exit 1
