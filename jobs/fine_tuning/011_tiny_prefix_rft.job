#!/bin/bash
#SBATCH --job-name=PrefixRFTTiny
#SBATCH --partition=gpu_h100
# Same three-GPU layout as 004_smoke_8b.job and 010_smoke_prefix_rft.job:
#   GPU 0 (exclusive): frozen sub-agent Qwen3-1.7B at util=0.08 (~7.5 GB)
#   GPUs 1-2: VERL N_GPUS=2, Qwen3-8B with LoRA rank 64
#SBATCH --gpus=3
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --time=00:30:00
#SBATCH --output=out/fine_tuning/prefix_rft/tiny_%A.log
#SBATCH --error=out/fine_tuning/prefix_rft/tiny_%A.err

# Prefix-RFT on two questions and one optimiser step, on real GPUs.
#
# What this job is for
# --------------------
# 010_smoke_prefix_rft.job asks "does the training pipeline survive Prefix-RFT?" on
# eight questions. This job asks the narrower and more urgent question: "on a real
# H100 run, does a teacher prefix actually get replayed, masked, advantage-corrected
# and entropy-clipped?" Two questions and one step is enough to answer that, and it
# answers it in minutes rather than hours.
#
# Both training questions have exactly three teacher decisions and are chosen for it
# (data/training/prefix_rft/tiny/train/tiny_train.parquet; see the config header). At
# global_step 0 the schedule gives l = 0.95, so k = floor(0.95 x 3) = 2: the plan and
# the tool call are replayed and the final answer is generated on-policy. One question
# goes through web_search, the other through code_generator.
#
# What it checks, in order of how much it would hurt to get wrong
# ---------------------------------------------------------------
#   A. The replayed text is the teacher's, verbatim, in exactly one rollout of four.
#      This is the end-to-end proof and it does not depend on any metric we log: it
#      reads the saved conversations and compares assistant turns against the store.
#   B. The prefix machinery was active — daemon promoted, actor installed, rollouts
#      prefixed, prefix tokens in the loss, entropy clip keeping about 20%.
#   C. Validation rollouts were NOT prefixed. Validation must stay on-policy or the
#      reported score is measuring the teacher.
#   D. A checkpoint was written and the step completed.
#
# A misconfigured Prefix-RFT run is indistinguishable from a GRPO run by its logs
# alone: it trains, checkpoints and reports success. A, B and C are what tell them
# apart.
#
# Run AFTER 008_build_prefix_demos.job and 009_run_tests_for_prefix_rft.job.
# Optional: SKIP_PIP_SETUP=1 in .env skips editable installs when cosmas-train is warm.

set -euo pipefail

echo "=========================================="
echo "MSc Thesis — Prefix-RFT on two questions (8B)"
echo "=========================================="
echo "Start time: $(date)"
echo "Job ID: ${SLURM_JOB_ID:-local}  Node: $(hostname)"
echo ""

module purge
module load 2025
module load Miniconda3/25.5.1-1
module load CUDA/12.8.0
module load cuDNN/9.10.1.4-CUDA-12.8.0

PROJECT_DIR="${PROJECT_DIR:-$HOME/azywot/msc-thesis}"
cd "$PROJECT_DIR" || exit 1
echo "Project directory: $PROJECT_DIR"

if [[ -f ".env" ]]; then
    echo "Loading environment variables from .env..."
    set -a
    source <(grep -v '^#' .env | grep -v '^$' | grep -v '^[[:space:]]*#')
    set +a
fi

if [[ -z "${SERPER_API_KEY:-}" && -z "${TAVILY_API_KEY:-}" ]]; then
    echo "ERROR: SERPER_API_KEY or TAVILY_API_KEY must be set for rollout workers."
    exit 1
fi

if ! conda env list | awk '{print $1}' | grep -qx "cosmas-train"; then
    echo "ERROR: conda env 'cosmas-train' not found."
    exit 1
fi

source activate cosmas-train
export PYTHONNOUSERSITE=1

case "${SKIP_PIP_SETUP:-}" in
    1|true|TRUE|yes|YES)
        echo "SKIP_PIP_SETUP is set — reusing the current cosmas-train."
        ;;
    *)
        echo "Installing msc-thesis package..."
        python -m pip install -e .
        bash jobs/cosmas_train_pip_reconcile.sh
        ;;
esac
python -c "import agent_engine, fine_tuning, verl, vllm; from fine_tuning.agentflow import LitAgent, Trainer, reward; print('Training imports OK')"

CONFIG=experiments/configs/fine_tuning/config_prefix_rft_tiny8b.yaml
DEMOS="${PREFIX_DEMOS_PATH:-data/training/prefix_rft/prefix_demos.parquet}"
TRAIN_PARQUET=data/training/prefix_rft/tiny/train/tiny_train.parquet
VAL_PARQUET=data/training/prefix_rft/tiny/val/tiny_val.parquet

mkdir -p out/fine_tuning/prefix_rft

for required_file in "$CONFIG" "$DEMOS" "$TRAIN_PARQUET" "$VAL_PARQUET"; do
    if [[ ! -f "$required_file" ]]; then
        echo "ERROR: missing required file: $required_file"
        [[ "$required_file" == "$DEMOS" ]] && \
            echo "  Build it first: sbatch jobs/fine_tuning/008_build_prefix_demos.job"
        [[ "$required_file" == *"tiny"* ]] && \
            echo "  Build it first: python scripts/build_tiny_prefix_split.py"
        exit 1
    fi
done

# ── Pre-flight: both questions must be prefixable ────────────────────────────
# The whole point of picking these two is that k > 0 for both. If that stopped
# being true the run would pass while exercising nothing, so assert it here rather
# than discover it in the post-run checks an hour later.
echo ""
echo "Checking the two training questions against the demonstration store..."
python - "$DEMOS" "$TRAIN_PARQUET" <<'PYCOVER'
import sys

import pandas as pd

from verl_ext.prefix_rft.demos import DemoStore
from verl_ext.prefix_rft.schedule import PrefixStepSchedule

store = DemoStore.from_parquet(sys.argv[1])
train = pd.read_parquet(sys.argv[2])
# Mirror the config: low stays high (test-only low_target=0.9), so l lands in
# [0.9, 0.95] and k = floor(l * m) is deterministic on any step.
schedule = PrefixStepSchedule(low_init=0.95, low_target=0.9, high=0.95, n_steps=1, seed=42)

bad = []
for i, q in enumerate(train["question"]):
    n = store.n_steps(q)
    # global_step=1: verl's global_steps starts at 1, so step 0 is never used. Asking
    # the schedule about step 0 is what made this check disagree with the run.
    k = schedule.sample_k(n, global_step=1) if n else 0
    print(f"  [{i}] n_steps={n}  k(step 1)={k}  {q[:60]!r}")
    if k < 1 or k >= n:
        bad.append(i)

if bad:
    sys.exit(
        f"FAIL: rows {bad} would be replayed with k=0 or with no on-policy continuation. "
        "This run needs both: prefix tokens AND generated tokens in the same trajectory."
    )
print("  both questions replay part of a demonstration and finish on-policy")
PYCOVER

# ── Pre-flight: the launch config must resolve ───────────────────────────────
# Builds the exact command a real run would issue and appends Hydra's --cfg job, so
# every override is validated without Ray, GPUs or weights. Job 25749264 spent an
# allocation to discover an unresolvable config_path; this costs seconds and fails
# before the sub-agent server is even started.
echo ""
echo "Dry-running the launch config..."
if ! python scripts/launch_verl.py --config "$CONFIG" --dry-run; then
    echo "FAIL — the launch config does not resolve. Nothing was started."
    exit 1
fi

VERL_PID=""
SUBAGENT_PID=""
ORCHESTRATOR_PID=""
CRASH_MONITOR_PID=""
cleanup() {
    [[ -n "${CRASH_MONITOR_PID:-}" ]] && kill "$CRASH_MONITOR_PID" 2>/dev/null || true
    if [[ -n "${ORCHESTRATOR_PID:-}" ]] && kill -0 "$ORCHESTRATOR_PID" >/dev/null 2>&1; then
        echo "Stopping rollout workers (pid=$ORCHESTRATOR_PID)..."
        kill "$ORCHESTRATOR_PID" || true
        wait "$ORCHESTRATOR_PID" || true
    fi
    if [[ -n "${VERL_PID:-}" ]] && kill -0 "$VERL_PID" >/dev/null 2>&1; then
        echo "Stopping VERL server (pid=$VERL_PID)..."
        kill "$VERL_PID" || true
        wait "$VERL_PID" || true
    fi
    echo "Stopping Ray background processes..."
    ray stop --force 2>/dev/null || true
    if [[ -n "${SUBAGENT_PID:-}" ]] && kill -0 "$SUBAGENT_PID" >/dev/null 2>&1; then
        echo "Stopping frozen sub-agent server (pid=$SUBAGENT_PID)..."
        kill "$SUBAGENT_PID" || true
        wait "$SUBAGENT_PID" || true
    fi
}
trap cleanup EXIT

# Watch a log; SIGTERM this script on a fatal CUDA/NCCL/Ray error so the EXIT trap
# fires and every background process dies immediately. In bash, $$ inside () is the
# parent script PID, not the subshell.
start_crash_monitor() {
    local logfile="$1" label="$2"
    (
        while [[ ! -f "$logfile" ]]; do sleep 2; done
        tail -n 0 -F "$logfile" 2>/dev/null \
        | grep --line-buffered -E \
            "CUDA (Error|out of memory)|RuntimeError: CUDA|\
NCCL (error|failure)|ncclSystemError|ncclInternalError|ncclCommAbort|\
RayActorError|ActorDiedError|WorkerDied|The actor died unexpectedly|\
Segmentation fault|Aborted \(core dumped\)|^Killed\$|\
FATAL ERROR|Fatal Python error" \
        | { IFS= read -r line
            printf '\n=== FATAL CRASH [%s] ===\n%s\nKilling job...\n' "$label" "$line" >&2
            kill -TERM $$ ; }
    ) &
    CRASH_MONITOR_PID=$!
}

JOB="${SLURM_JOB_ID:-local}"
LOGDIR=out/fine_tuning/prefix_rft
VERL_LOG="$LOGDIR/tiny_${JOB}_verl.log"
SUBAGENT_LOG="$LOGDIR/tiny_${JOB}_subagent.log"
ORCH_LOG="$LOGDIR/tiny_${JOB}_orchestrator.log"

VERL_RUN_TAG="$(date +%d-%m-%Y_%H-%M)-${JOB}"
export VERL_RUN_TAG
echo ""
echo "Run tag: $VERL_RUN_TAG"

EXPERIMENT_NAME="qwen3-8b-prefix-rft-tiny"
RUN_DIR="experiments/results/fine_tuning/${EXPERIMENT_NAME}/${VERL_RUN_TAG}"
CKPT_DIR="${PROJECT_DIR}/experiments/results/fine_tuning/${EXPERIMENT_NAME}"
echo "Run directory:  $RUN_DIR"
echo "Checkpoints:    $CKPT_DIR"

# ── 1. Frozen sub-agent vLLM server (GPU 0) ──────────────────────────────────
echo ""
echo "Starting frozen sub-agent (Qwen/Qwen3-1.7B, port 9998, physical GPU 0)..."
VLLM_USE_V1=0 CUDA_VISIBLE_DEVICES=0 vllm serve Qwen/Qwen3-1.7B \
    --port 9998 \
    --tensor-parallel-size 1 \
    --gpu-memory-utilization 0.08 \
    --max-model-len 16384 \
    > "$SUBAGENT_LOG" 2>&1 &
SUBAGENT_PID=$!
export SUBAGENT_ENDPOINT="http://localhost:9998/v1"

echo "Waiting for the sub-agent to answer (up to 10 min)..."
_deadline=$((SECONDS + 600))
while (( SECONDS < _deadline )); do
    if curl -fsS --max-time 5 http://127.0.0.1:9998/v1/models >/dev/null 2>&1; then
        echo "Sub-agent is up."
        break
    fi
    if ! kill -0 "$SUBAGENT_PID" >/dev/null 2>&1; then
        echo "FAIL — sub-agent exited during startup. See $SUBAGENT_LOG"
        tail -40 "$SUBAGENT_LOG"
        exit 1
    fi
    sleep 10
done
if (( SECONDS >= _deadline )); then
    echo "FAIL — sub-agent not ready after 10 min. See $SUBAGENT_LOG"
    exit 1
fi

# VERL gets GPUs 1 and 2 (N_GPUS=2 in the config).
export CUDA_VISIBLE_DEVICES=1,2
export PYTHONUNBUFFERED=1

# ── 2. VERL server ───────────────────────────────────────────────────────────
echo ""
echo "Starting VERL (config_prefix_rft_tiny8b.yaml, N_GPUS=2)..."
python scripts/launch_verl.py --config "$CONFIG" > "$VERL_LOG" 2>&1 &
VERL_PID=$!
start_crash_monitor "$VERL_LOG" "VERL"

AGENTFLOW_PORT="${AGENTFLOW_PORT:-9999}"
echo "Polling http://localhost:${AGENTFLOW_PORT}/task for AgentFlow readiness (up to 40 min)..."
_deadline=$((SECONDS + 2400))
while (( SECONDS < _deadline )); do
    if curl -fsS --max-time 5 "http://127.0.0.1:${AGENTFLOW_PORT}/task" >/dev/null 2>&1; then
        echo "AgentFlow is responding on port ${AGENTFLOW_PORT}."
        break
    fi
    if ! kill -0 "$VERL_PID" >/dev/null 2>&1; then
        echo "FAIL — VERL exited before AgentFlow came up. See $VERL_LOG"
        tail -60 "$VERL_LOG"
        exit 1
    fi
    sleep 10
done
if (( SECONDS >= _deadline )); then
    echo "FAIL — AgentFlow not ready after 40 min. See $VERL_LOG"
    exit 1
fi

# ── 3. Rollout workers ───────────────────────────────────────────────────────
echo ""
echo "Starting rollout workers..."
python scripts/train_orchestrator.py --config "$CONFIG" > "$ORCH_LOG" 2>&1 &
ORCHESTRATOR_PID=$!
# The orchestrator is a client of VERL; waiting on it before VERL exits deadlocks.
# `|| VERL_RC=$?` keeps `set -e` from killing the script on a non-zero exit, so a
# failed run prints its own tail instead of ending as a bare exit code in the SLURM log.
VERL_RC=0
wait $VERL_PID || VERL_RC=$?
if [[ $VERL_RC -ne 0 ]]; then
    echo ""
    echo "FAIL — VERL exited with status $VERL_RC. Last 80 lines of $VERL_LOG:"
    tail -80 "$VERL_LOG"
    echo ""
    echo "Last 40 lines of $ORCH_LOG:"
    tail -40 "$ORCH_LOG" 2>/dev/null || true
    exit 1
fi
echo ""
echo "Training finished at: $(date)"

# ── Check 0: no episode may have failed ──────────────────────────────────────
# OrchestratorRollout catches every episode exception and completes the rollout with
# answer="None". That is right for a flaky tool call, but it also means a fatal bug in
# the replay path produces a rollout that looks merely unlucky. Job 25754114 died this
# way: len() on the tool-registry proxy raised, all six prefixed episodes were swallowed,
# and dispatch plus replay both reported healthy while nothing reached the loss.
echo ""
echo "── Check 0: no episode raised ───────────────────────────────────────────"
if grep -q "Episode failed" "$ORCH_LOG" 2>/dev/null; then
    echo "FAIL — episodes raised and were swallowed by the rollout's except clause:"
    grep -oE "\[OrchestratorRollout\] Episode failed: .{0,140}" "$ORCH_LOG" | sort | uniq -c
    echo ""
    echo "Every prefixed episode that raises completes as an empty on-policy trajectory,"
    echo "so the prefix metrics below would be zero for a reason unrelated to Prefix-RFT."
    exit 1
fi
echo "PASS — no episode raised."

echo ""
echo "── Rollout worker log (Prefix-RFT lines) ────────────────────────────────"
grep -E "PrefixOrchestratorRollout|Prefix-RFT enabled|prefix_k" "$ORCH_LOG" | head -20 || \
    echo "  (no Prefix-RFT lines in the orchestrator log — check $ORCH_LOG)"

# ── 4. Check A: the replayed text is the teacher's, verbatim ─────────────────
# This is the check that does not trust any metric. It reads the saved conversations
# and compares assistant turns against the demonstration store. With rollout.n = 4
# and n_prefixed_rollouts = 1, exactly one rollout per question should carry the
# teacher's first two assistant turns and none of the others should.
echo ""
echo "── Check A: replayed turns carry the teacher's text ─────────────────────"
python - "$DEMOS" "$RUN_DIR" <<'PYVERBATIM'
import glob
import json
import sys
from collections import defaultdict

from verl_ext.prefix_rft.demos import DemoStore

demos_path, run_dir = sys.argv[1], sys.argv[2]
store = DemoStore.from_parquet(demos_path)

paths = sorted(glob.glob(f"{run_dir}/rollout_data/train/*/*.json"))
if not paths:
    sys.exit(f"FAIL: no training rollouts saved under {run_dir}/rollout_data/train/")

by_question = defaultdict(list)
for path in paths:
    record = json.load(open(path))
    by_question[record["question"]].append((path, record))


def leading_match(assistant, teacher):
    """How many leading assistant turns are the teacher's, verbatim."""
    n = 0
    for got, want in zip(assistant, teacher):
        if got != want:
            break
        n += 1
    return n


failures = []
for question, records in by_question.items():
    steps = store.steps(question)
    if not steps:
        failures.append(f"{question[:50]!r}: not in the demonstration store")
        continue
    teacher = [s["response"] for s in steps]

    # k is NOT recomputed here. The schedule is stochastic and lives in the trainer;
    # a verifier that predicts k tests its own copy of the schedule, and disagreeing
    # with the run is exactly how job 25753400 reported a false failure. Read what
    # actually happened instead, and assert the invariants that must hold for any k.
    matches = []
    for path, record in records:
        assistant = [
            m.get("content", "")
            for m in record.get("output_messages", [])
            if m.get("role") == "assistant"
        ]
        matches.append((path, record, assistant, leading_match(assistant, teacher)))

    replayed = [m for m in matches if m[3] > 0]
    print(f"\n  question: {question[:60]!r}")
    print(f"    demonstration has {len(steps)} decisions")
    print(f"    {len(records)} rollouts saved, {len(replayed)} replayed a teacher prefix")
    print(f"    leading-match counts: {sorted(m[3] for m in matches)}")

    if not replayed:
        failures.append(
            f"{question[:50]!r}: no rollout replayed any teacher decision. Check the "
            "'Prefix dispatch' line for the k values the daemon actually sent."
        )
        continue
    if len(replayed) > 1:
        failures.append(
            f"{question[:50]!r}: {len(replayed)} rollouts replayed the teacher, expected "
            "1 (n_prefixed_rollouts = 1)"
        )
        continue

    path, record, assistant, k = replayed[0]
    print(f"    replayed rollout: {path.split('/')[-1]}  k={k}")
    print(f"      turn 0 (replayed, {len(teacher[0])} chars): {teacher[0][:70]!r}")

    # The two invariants that must hold whatever k the schedule drew.
    if k >= len(steps):
        failures.append(
            f"{question[:50]!r}: k={k} covers the whole demonstration, so nothing was "
            "generated on-policy and the trajectory is pure imitation"
        )
    if len(assistant) <= k:
        failures.append(
            f"{question[:50]!r}: the prefixed rollout has no turn past the prefix; "
            "no on-policy continuation was generated"
        )
    else:
        print(f"      turn {k} (on-policy):  {assistant[k][:70]!r}")
        if assistant[k] in teacher:
            failures.append(
                f"{question[:50]!r}: turn {k} should be generated but matches a "
                "demonstration step — replay did not stop at k"
            )
    print(f"    reward: {record.get('reward')}")

if failures:
    print("\nFAIL — replay did not behave as specified:")
    for f in failures:
        print(f"  - {f}")
    sys.exit(1)
print("\nPASS — exactly one rollout per question replayed the teacher verbatim, "
      "then continued on-policy.")
PYVERBATIM

# ── 5. Check C: validation rollouts were not prefixed ────────────────────────
# Validation must stay on-policy. If a demonstration leaked into it the reported
# score would be measuring the teacher, and nothing else in the run would say so.
echo ""
echo "── Check C: validation rollouts stayed on-policy ────────────────────────"
python - "$DEMOS" "$RUN_DIR" <<'PYVAL'
import glob
import json
import sys

from verl_ext.prefix_rft.demos import DemoStore

store = DemoStore.from_parquet(sys.argv[1])
paths = sorted(glob.glob(f"{sys.argv[2]}/rollout_data/val/*/*.json"))
if not paths:
    print("  no validation rollouts were saved; nothing to check")
    sys.exit(0)

leaked = []
for path in paths:
    record = json.load(open(path))
    steps = store.steps(record["question"])
    if not steps:
        continue
    teacher = {s["response"] for s in steps}
    assistant = [
        m.get("content", "")
        for m in record.get("output_messages", [])
        if m.get("role") == "assistant"
    ]
    if any(a in teacher for a in assistant):
        leaked.append(path)

print(f"  checked {len(paths)} validation rollouts")
if leaked:
    print("FAIL — a demonstration was replayed during validation:")
    for path in leaked:
        print(f"  - {path}")
    sys.exit(1)
print("PASS — no validation rollout replayed a demonstration.")
PYVAL

# ── 6. Check B: the prefix machinery reported itself active ──────────────────
echo ""
echo "── Check B: the prefix machinery was active ─────────────────────────────"
python - "$VERL_LOG" <<'PYVERIFY'
import re
import sys

text = open(sys.argv[1], errors="replace").read()
failures = []

def numbers(metric):
    pattern = rf"{re.escape(metric)}['\"]?\s*[:=]\s*(-?[0-9]*\.?[0-9]+)"
    return [float(m) for m in re.findall(pattern, text)]

if "Promoted AgentModeDaemon to PrefixRFTDaemon" not in text:
    failures.append("the daemon was never promoted: prefix_k was never dispatched")
if "Installed PrefixRFTActor" not in text:
    failures.append("PrefixRFTActor was never installed: no entropy clipping happened")

prefixed = numbers("actor/n_prefixed_rollouts")
if not prefixed or max(prefixed) == 0:
    failures.append("no rollout was ever prefixed (k was 0 everywhere)")

tokens = numbers("actor/num_prefix_tokens")
if not tokens or max(tokens) == 0:
    failures.append("no prefix tokens entered the loss")

zeroed = numbers("actor/prefix_tokens_zeroed")
total = numbers("actor/prefix_tokens_total")
if zeroed and total:
    kept = 1 - (sum(zeroed) / max(1.0, sum(total)))
    print(f"  entropy clip kept {kept:.1%} of prefix tokens (paper: 20%)")
    if not 0.10 <= kept <= 0.35:
        failures.append(f"entropy clip kept {kept:.1%}, expected about 20%")
else:
    failures.append("the entropy clip never reported how many tokens it zeroed")

off_ratio = numbers("actor/off_ratio")
if off_ratio:
    print(f"  off_ratio (demonstration share of the batch) = {max(off_ratio):.3f}")

print(f"  max prefixed rollouts per step = {max(prefixed) if prefixed else 0}")
print(f"  max prefix tokens per step     = {max(tokens) if tokens else 0}")

if failures:
    print("\nFAIL — the prefix machinery was not active:")
    for f in failures:
        print(f"  - {f}")
    sys.exit(1)
print("\nPASS — prefix machinery active.")
PYVERIFY

# ── 7. Check D: a checkpoint was written ─────────────────────────────────────
echo ""
echo "── Check D: the step completed and a LoRA adapter was saved ─────────────"
if find "$CKPT_DIR" -maxdepth 5 -name "adapter_model.safetensors" -path "*/actor/lora_adapter/*" 2>/dev/null | grep -q .; then
    find "$CKPT_DIR" -maxdepth 5 -name "adapter_model.safetensors" -path "*/actor/lora_adapter/*" | head -5
    echo "PASS — checkpoint found."
else
    echo "FAIL — no LoRA adapter found under $CKPT_DIR"
    exit 1
fi

echo ""
echo "=========================================="
echo "Prefix-RFT two-question test complete at: $(date)"
echo "Replay, masking, advantage correction and entropy clipping all verified on GPU."
echo "=========================================="
